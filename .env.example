# ─────────────────────────────────────────────────────────────────────────────
# TruthLens AI — Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────
#
# HOW TO USE:
#   1. Copy this file and rename it to  .env  (no ".example" extension)
#   2. Fill in the values for the provider you want to use
#   3. The .env file is loaded automatically when the app starts
#   4. Never commit your .env file to version control (it is in .gitignore)
#
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM Provider Selection ───────────────────────────────────────────────────
#
# Options:
#   openrouter  (recommended) — access any model via one subscription
#   gemini                    — Google Gemini API
#   openai                    — OpenAI GPT models
#   ollama                    — Local models, no API key required
#
LLM_PROVIDER=openrouter


# ─────────────────────────────────────────────────────────────────────────────
# OPTION 1 — OpenRouter  ← RECOMMENDED (you already have a subscription)
# Get your key at: https://openrouter.ai/keys
#
# Popular free/cheap models you can use as OPENROUTER_MODEL:
#   google/gemini-flash-1.5          (fast, free tier available)
#   google/gemini-2.0-flash-001      (latest Gemini Flash)
#   meta-llama/llama-3.1-8b-instruct:free  (completely free)
#   anthropic/claude-3.5-haiku       (fast Claude)
#   openai/gpt-4o-mini               (cheap GPT)
#   mistralai/mistral-7b-instruct:free     (free Mistral)
#
# Browse all models at: https://openrouter.ai/models
# ─────────────────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-flash-1.5


# ─────────────────────────────────────────────────────────────────────────────
# OPTION 2 — Google Gemini
# Get a free API key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────────────────

# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash


# ─────────────────────────────────────────────────────────────────────────────
# OPTION 3 — OpenAI
# Get an API key at: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────

# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo


# ─────────────────────────────────────────────────────────────────────────────
# OPTION 4 — Ollama (fully local, no API key required)
# Install: https://ollama.com  then run: ollama pull llama3
# ─────────────────────────────────────────────────────────────────────────────

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
